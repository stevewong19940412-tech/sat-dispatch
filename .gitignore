node_modules
dist
*.db
*.db-shm
*.db-wal
client/dist
data/gp_raw.json
data/*.log
__pycache__/

# 部署产物：每次 blade app deploy 自动重新生成（~80MB），
# 提交进 git 会让 .git 膨胀到数 GB，导致部署打包超时（本次 4.1G / >600s）
deploy/*.zip

# ── 敏感信息与环境（公开仓库必须排除）──────────────────────────
.env
.env.*
!.env.example
pb_data/
data/pb_data/
*.pem
*.key
*.p12
offline-pkg/
sat-dispatch-offline-*.tar.gz
sat-dispatch-offline-*.tar.gz.sha256

# 本地临时/调试产物
browser-screenshots/
*.log

# ── 二进制产物（可重新获取，不进版本库）─────────────────────────
# PocketBase 可执行文件（30MB，从官方 release 下载）
server/pocketbase
# better-sqlite3 预编译包与 vendor 快照（pnpm install / rebuild 会重建）
vendor_node_modules/
server/vendor_node_modules.tar.gz

# ── 非代码文件不进版本库（用户要求：仓库只留代码）───────────────
# 文档 / 汇报材料
docs/
*.pptx
*.ppt
*.docx
*.doc
*.pdf
# 截图与图片（运行时会用到的贴图除外）
*.png
*.jpg
*.jpeg
!client/public/textures/*.jpg
# 调试/一次性脚本
compare*.mjs
diagnose*.mjs
paste_*
# Python 缓存
__pycache__/
*.pyc
# 抓取的原始数据（体积大且可重新获取，卫星基础数据保留）
data/webfetch_raw/
data/wf_*.json
data/all_candidates.json
data/china_candidates.json
data/intl_candidates.json
data/legacy_remote_sensing.json
data/missing_norads.json
data/webfetch_log.md
