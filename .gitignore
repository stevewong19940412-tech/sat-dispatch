# 应用项目通用 Git 忽略规则
# 代码库只保留源码、配置和迁移脚本；依赖、构建产物、运行数据和本机临时文件都不入库。
# 这是起步默认值，可按项目实际情况增删。

# ---- 依赖包：由 lock 文件重新安装，不入库 ----
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz
.pnp.*
bower_components/
jspm_packages/
# 注意：沙盒离线安装用的 vendor/ 目录要留在库里，不要忽略。

# ---- Python 依赖与缓存 ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# ---- 构建产物：可重新构建 ----
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.astro/
.output/
.vercel/
.netlify/
storybook-static/
*.tsbuildinfo

# ---- 构建与测试缓存 ----
.cache/
.vite/
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache
coverage/
htmlcov/
.coverage
.nyc_output/
test-results/
playwright-report/
blob-report/

# ---- 密钥与本机配置：泄露风险最高，务必保持忽略 ----
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.p12
*.pfx
.netrc

# ---- 运行数据与本地数据库：属于数据，不属于代码 ----
pb_data/
.pb/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
# 带 - 的写法覆盖 SQLite 的 -journal / -wal / -shm 等附属文件，漏掉会连运行数据一起提交。
# 注意：PocketBase 的 pb_migrations/ 是表结构来源，必须提交。

# ---- 日志与进程文件 ----
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock

# ---- 临时文件与备份 ----
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# ---- 编辑器与操作系统 ----
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 平台注入的运行时目录：不是项目成果 ----
.agents/
.blade/
